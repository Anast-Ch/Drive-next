<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_white"
    tools:context=".presentation.no_connection.NoConnectionActivity">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRetry"
        android:layout_width="0dp"
        android:layout_height="@dimen/no_connection_button_height"
        android:layout_marginStart="@dimen/no_connection_button_horizontal_margin"
        android:layout_marginEnd="@dimen/no_connection_button_horizontal_margin"
        android:layout_marginBottom="@dimen/no_connection_button_bottom_margin"
        app:backgroundTint="@color/button_primary_background"
        app:cornerRadius="@dimen/no_connection_button_radius"
        app:rippleColor="@color/white"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:paddingStart="@dimen/no_connection_button_padding_horizontal"
        android:paddingEnd="@dimen/no_connection_button_padding_horizontal"
        android:paddingTop="@dimen/no_connection_button_padding_vertical"
        android:paddingBottom="@dimen/no_connection_button_padding_vertical"
        android:fontFamily="@font/montserrat_regular"
        android:includeFontPadding="false"
        android:text="@string/btn_retry"
        android:textAllCaps="false"
        android:textColor="@color/button_primary_text"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="@dimen/no_connection_progress_size"
        android:layout_height="@dimen/no_connection_progress_size"
        android:indeterminateTint="@color/button_primary_text"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/btnRetry"
        app:layout_constraintEnd_toEndOf="@id/btnRetry"
        app:layout_constraintStart_toStartOf="@id/btnRetry"
        app:layout_constraintTop_toTopOf="@id/btnRetry" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btnRetry"
        app:layout_constraintVertical_bias="0.4">

        <ImageView
            android:id="@+id/ivNoConnectionIcon"
            android:layout_width="@dimen/no_connection_icon_size"
            android:layout_height="@dimen/no_connection_icon_size"
            android:contentDescription="@null"
            android:src="@drawable/ic_no_connection" />

        <TextView
            android:id="@+id/tvNoConnectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/no_connection_block_gap"
            android:paddingStart="@dimen/no_connection_text_horizontal_margin"
            android:paddingEnd="@dimen/no_connection_text_horizontal_margin"
            android:fontFamily="@font/montserrat_semibold"
            android:gravity="center"
            android:text="@string/no_connection_title"
            android:textColor="@color/text_primary_color"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/tvNoConnectionSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/no_connection_block_gap"
            android:paddingStart="@dimen/no_connection_text_horizontal_margin"
            android:paddingEnd="@dimen/no_connection_text_horizontal_margin"
            android:fontFamily="@font/montserrat_regular"
            android:gravity="center"
            android:text="@string/no_connection_subtitle"
            android:textColor="@color/text_primary_color"
            android:textSize="14sp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
