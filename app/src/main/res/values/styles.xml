<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.MyProject.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/button_primary_background_selector</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:fontFamily">@font/montserrat_semibold</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/button_primary_text</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Widget.MyProject.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="backgroundTint">@color/button_secondary_background</item>
        <item name="strokeColor">@color/stroke_color</item>
        <item name="strokeWidth">@dimen/stroke_width</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:fontFamily">@font/montserrat_semibold</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/button_secondary_text</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Widget.MyProject.FieldLabel" parent="">
        <item name="android:fontFamily">@font/montserrat_medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_label_color</item>
    </style>

    <style name="TextAppearance.MyProject.Error" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">@font/montserrat_regular</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/error_color</item>
    </style>

    <style name="Widget.MyProject.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="hintEnabled">false</item>
        <item name="errorEnabled">false</item>
        <item name="boxBackgroundColor">@color/background_white</item>
        <item name="boxStrokeColor">@color/input_stroke_color_selector</item>
        <item name="boxStrokeErrorColor">@color/error_color</item>
        <item name="boxStrokeWidth">@dimen/stroke_width</item>
        <item name="boxStrokeWidthFocused">@dimen/stroke_width</item>
        <item name="boxCornerRadiusTopStart">@dimen/input_corner_radius</item>
        <item name="boxCornerRadiusTopEnd">@dimen/input_corner_radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/input_corner_radius</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/input_corner_radius</item>
        <item name="errorTextAppearance">@style/TextAppearance.MyProject.Error</item>
        <item name="errorTextColor">@color/error_color</item>
        <item name="errorIconDrawable">@null</item>
        <item name="endIconTint">@color/text_secondary_color</item>
        <item name="startIconTint">@color/text_secondary_color</item>
        <item name="android:textColorHint">@color/text_secondary_color</item>
    </style>

    <style name="Widget.MyProject.TextInputEditText" parent="Widget.Material3.TextInputEditText.OutlinedBox">
        <item name="android:fontFamily">@font/montserrat_regular</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_primary_color</item>
        <item name="android:textColorHint">@color/text_secondary_color</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:minHeight">@dimen/input_min_height</item>
    </style>

    <style name="Widget.MyProject.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/button_primary_background</item>
        <item name="android:fontFamily">@font/montserrat_medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

</resources>